<!doctype html>
<html lang="ko">
<head>
<meta charset="utf-8">
<meta http-equiv="Content-Security-Policy" content="default-src 'none'; img-src data: 'self'; font-src data: 'self'; style-src 'unsafe-inline'">
<meta name="viewport" content="width=device-width, initial-scale=1">
<meta name="generator" content="HowtoNote">
<title>{{.Doc.Title}}</title>
<style>
{{.FontFaces}}
body{margin:0;font-family:{{.Font}};font-size:15px;line-height:1.6;color:#1f2329;background:#fff}
main{max-width:880px;margin:0 auto;padding:32px 24px}
.cover{text-align:center;padding:120px 0 80px}
.cover h1,.title{font-size:28px;margin:0 0 12px}
.date{color:#5f6368}
.toc ol{list-style:none;padding:0}
.toc li{margin:4px 0}
.toc li.sub{padding-left:24px}
.toc a{color:inherit;text-decoration:none}
h2{font-size:21px;margin:32px 0 12px}
h3{font-size:18px;margin:24px 0 10px 16px}
h4{font-size:16px;margin:16px 0 6px}
h5{font-size:15px;margin:12px 0 6px}
figure{margin:12px 0;text-align:center}
figure img{max-width:{{.ImageWidth}}%;height:auto;border:1px solid #e0e3e7}
table{border-collapse:collapse;width:100%;margin:12px 0}
th,td{border:1px solid #9aa0a6;padding:6px 8px;text-align:left;vertical-align:top}
th{background:#f1f3f4}
td p,th p{margin:0}
a{color:#1a73e8}
.callout{margin:12px 0;padding:10px 14px;border-left:6px solid #1a73e8;border-radius:6px;background:#e8f0fe}
.callout.tip{border-left-color:#188038;background:#e6f4ea}
.callout.warning{border-left-color:#f9ab00;background:#fef7e0}
.callout.danger{border-left-color:#d93025;background:#fce8e6}
.callout-title{font-weight:700;margin:0 0 4px}
{{- if .Print}}
@page{size:{{.PageSize}};margin:20mm 15mm}
figure img{max-height:{{.ImageMaxHeight}}}
main{max-width:none;padding:0}
.cover,.toc{break-after:page}
.newpage{break-before:page}
h2,h3,h4,h5{break-after:avoid}
figure,.callout,tr{break-inside:avoid}
.before{break-after:avoid}
{{- end}}
</style>
</head>
<body>
<main>
{{- if .O.Cover}}
<section class="cover"><h1>{{.Doc.Title}}</h1><p class="date">{{.Doc.Date}}</p></section>
{{- else}}
<h1 class="title">{{.Doc.Title}}</h1>
{{- end}}
{{- if and .O.TOC .Doc.Steps}}
<nav class="toc"><h2>목차</h2><ol>{{range .Doc.Steps}}<li{{if .Sub}} class="sub"{{end}}><a href="#step-{{.Number}}">{{.Heading}}</a></li>{{end}}</ol></nav>
{{- end}}
{{- range $i, $s := .Doc.Steps}}
<section class="step{{if and $.O.StepPerPage (not .Sub) $i}} newpage{{end}}" id="step-{{.Number}}">
{{- if .Before}}<div class="before">{{range .Before}}{{template "callout" .}}{{end}}</div>{{end}}
{{- if .Sub}}<h3>{{.Heading}}</h3>{{else}}<h2>{{.Heading}}</h2>{{end}}
{{- with index $.Images .ID}}<figure><img src="{{.}}" alt="{{$s.Heading}} 화면"></figure>{{end}}
{{- template "blocks" .Blocks}}
{{- range .After}}{{template "callout" .}}{{end}}
</section>
{{- end}}
</main>
</body>
</html>
{{- define "callout"}}<aside class="callout {{.Kind}}"><p class="callout-title">{{.Heading}}</p>{{template "blocks" .Blocks}}</aside>{{end}}
{{- define "blocks"}}{{range .}}{{template "block" .}}{{end}}{{end}}
{{- define "block"}}
{{- if eq .Kind "p"}}<p>{{template "runs" .Runs}}</p>
{{- else if eq .Kind "h"}}{{if eq .Level 4}}<h5>{{template "runs" .Runs}}</h5>{{else}}<h4>{{template "runs" .Runs}}</h4>{{end}}
{{- else if eq .Kind "list"}}{{if .Ordered}}<ol start="{{.Start}}">{{else}}<ul>{{end}}{{range .Items}}<li>{{template "blocks" .}}</li>{{end}}{{if .Ordered}}</ol>{{else}}</ul>{{end}}
{{- else if eq .Kind "table"}}<table>{{range .Rows}}<tr>{{range .}}{{if .Header}}<th>{{template "blocks" .Blocks}}</th>{{else}}<td>{{template "blocks" .Blocks}}</td>{{end}}{{end}}</tr>{{end}}</table>
{{- end}}
{{- end}}
{{- define "runs"}}{{range .}}{{if .Break}}<br>{{else}}{{template "run" .}}{{end}}{{end}}{{end}}
{{- define "run"}}{{if .Href}}<a href="{{.Href}}">{{end}}{{if .Bold}}<strong>{{end}}{{if .Italic}}<em>{{end}}{{if .Underline}}<u>{{end}}{{.Text}}{{if .Underline}}</u>{{end}}{{if .Italic}}</em>{{end}}{{if .Bold}}</strong>{{end}}{{if .Href}}</a>{{end}}{{end}}
